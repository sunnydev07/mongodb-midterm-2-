# Server Port
PORT=3000

# Execution Mode: "auto" (tries MongoDB, falls back to simulation), "live", or "simulation"
APP_MODE=auto

# Scenario A2: Student Records (Standalone or Primary MongoDB URI)
MONGO_URI_STUDENTS=mongodb://127.0.0.1:27017

# Scenario A4: Banking App (3-Node Replica Set rs0)
MONGO_URI_BANKING=mongodb://127.0.0.1:27017,127.0.0.1:27018,127.0.0.1:27019/?replicaSet=rs0
